---
const { id, question, answer } = Astro.props;
---

<div class="border-b pb-4">
    <button 
      class="w-full text-left text-xl font-semibold text-green-600 focus:outline-none"
      type="button"
      onclick={`toggleAnswer('${id}');`}
    >
        { question }
    </button>
    <div id={id} class="mt-2 text-gray-700 hidden">
        { answer }
    </div>
</div>

<script>
	export function toggleAnswer(faqId: string) {
		const faqElement = document.getElementById(faqId);
		faqElement!.classList.toggle("hidden");
	}
</script>
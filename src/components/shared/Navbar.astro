---
const currentPath = Astro.url.pathname;
---

<nav class="bg-[#127475ff] border-gray-200">
  <div class="max-w-screen-xl flex flex-wrap items-center justify-between mx-auto p-4">
    <a href="/" class="flex items-center space-x-3 rtl:space-x-reverse">
      <img src="/icons/logo.png" class="h-12" alt="Verdant Logo" />
    </a>
    <button data-collapse-toggle="navbar-default" type="button" class="inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-[#7de745ff] rounded-lg md:hidden focus:outline-none" aria-controls="navbar-default" aria-expanded="false">
      <span class="sr-only">Open main menu</span>
      <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 17 14">
        <path stroke="#ffffff" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 1h15M1 7h15M1 13h15"/>
      </svg>
    </button>
    <div class="hidden w-full md:block md:w-auto" id="navbar-default">
      <ul class="font-medium flex flex-col p-4 md:p-0 mt-4 border border-gray-100 rounded-lg bg-[#127475ff] md:flex-row md:space-x-8 rtl:space-x-reverse md:mt-0 md:border-0">
        <li>
          <a 
            href="/farm-to-table/"
            class={`block py-2 px-3 rounded md:bg-transparent md:p-0 
              ${currentPath === '/farm-to-table/' ? 'text-[#7de745ff]' : 'text-white hover:text-[#cfffbbff]'}`} 
            aria-current={currentPath === '/farm-to-table/' ? 'page' : undefined}
          >
            Farm-to-Table
          </a>
        </li>
        <li>
          <a 
            href="/preparation-processes/" 
            class={`block py-2 px-3 rounded md:bg-transparent md:p-0 
              ${currentPath === '/preparation-processes/' ? 'text-[#7de745ff]' : 'text-white hover:text-[#cfffbbff]'}`} 
            aria-current={currentPath === '/preparation-processes/' ? 'page' : undefined}
          >
            Preparation
          </a>
        </li>
        <li>
          <a 
            href="/sustainability/" 
            class={`block py-2 px-3 rounded md:bg-transparent md:p-0 
              ${currentPath === '/sustainability/' ? 'text-[#7de745ff]' : 'text-white hover:text-[#cfffbbff]'}`} 
            aria-current={currentPath === '/sustainability/' ? 'page' : undefined}
          >
            Sustainability
          </a>
        </li>
        <li>
          <a 
            href="/menu/" 
            class={`block py-2 px-3 rounded md:bg-transparent md:p-0 
              ${currentPath === '/menu/' ? 'text-[#7de745ff]' : 'text-white hover:text-[#cfffbbff]'}`} 
            aria-current={currentPath === '/menu/' ? 'page' : undefined}
          >
            Menu
          </a>
        </li>
        <li>
          <a 
            href="/leaflets/" 
            class={`block py-2 px-3 rounded md:bg-transparent md:p-0 
              ${currentPath === '/leaflets/' ? 'text-[#7de745ff]' : 'text-white hover:text-[#cfffbbff]'}`} 
            aria-current={currentPath === '/leaflets/' ? 'page' : undefined}
          >
            Leaflets®
          </a>
        </li>
        <li>
          <a 
            href="/events/" 
            class={`block py-2 px-3 rounded md:bg-transparent md:p-0 
              ${currentPath === '/events/' ? 'text-[#7de745ff]' : 'text-white hover:text-[#cfffbbff]'}`} 
            aria-current={currentPath === '/events/' ? 'page' : undefined}
          >
            Events
          </a>
        </li>
        <li>
          <a 
            href="/blog/" 
            class={`block py-2 px-3 rounded md:bg-transparent md:p-0 
              ${currentPath === '/blog/' ? 'text-[#7de745ff]' : 'text-white hover:text-[#cfffbbff]'}`} 
            aria-current={currentPath === '/blog/' ? 'page' : undefined}
          >
            Blog
          </a>
        </li>
        <li>
          <a 
            href="/references/" 
            class={`block py-2 px-3 rounded md:bg-transparent md:p-0 
              ${currentPath === '/references/' ? 'text-[#7de745ff]' : 'text-white hover:text-[#cfffbbff]'}`} 
            aria-current={currentPath === '/references/' ? 'page' : undefined}
          >
            References
          </a>
        </li>
      </ul>
    </div>
  </div>
</nav>

<script>
	// This script toggles visibility on mobile.
	const toggleButton = document.querySelector('[data-collapse-toggle="navbar-default"]');
	const navbar = document.getElementById('navbar-default');
	toggleButton?.addEventListener('click', () => {
		navbar?.classList.toggle('hidden');
	});
</script>
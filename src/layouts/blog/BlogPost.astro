---
import Page from "../shared/Page.astro";

const { frontmatter } = Astro.props;
---

<Page title=`Blog | ${ frontmatter.title }`>
	<section>
		<img
			class="w-1/2 py-3 rounded-xl mx-auto"
			src={ frontmatter.image.url }
			alt={ frontmatter.image.alt }
		/>
		<article
			class="prose md:max-w-screen-md lg:max-w-screen-lg xl:max-w-screen-xl px-20"
		>
			<slot />
		</article>
	</section>
</Page>
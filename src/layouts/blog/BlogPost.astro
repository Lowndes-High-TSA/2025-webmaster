---
import Page from "../shared/Page.astro";

const { frontmatter } = Astro.props;
---

<Page title={`Blog | ${frontmatter.title}`}>
  <section class="py-20 md:py-24">
    <!-- Main Content Section -->
    <div class="flex flex-col md:flex-row gap-16 lg:gap-20 px-6 md:px-10">
      <!-- Blog Content -->
      <div class="flex-1 max-w-screen-xl">
        <img
          class="w-full md:w-2/3 lg:w-1/2 py-3 rounded-xl mx-auto transition-transform duration-300 hover:scale-105"
          src={frontmatter.image.url}
          alt={frontmatter.image.alt}
        />
		<article class="prose max-w-screen-xl px-4 md:px-8 py-6 mt-4 bg-white rounded-lg">
			<!-- Title and Description -->
			<h1 class="text-5xl font-extrabold text-green-700 mb-3">{ frontmatter.title }</h1>
			<p class="text-xl text-gray-700 mb-6">{ frontmatter.description }</p>
			<!-- Author, Date, and Read Time -->
			<div class="flex items-center space-x-6 mb-12 text-gray-600">
			  <div class="flex items-center space-x-2">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
				  <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
				</svg>
				<span class="text-sm">{ new Date(frontmatter.published).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) }</span>
			  </div>
			  <div class="flex items-center space-x-2">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
				  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
				</svg>
				<span class="text-sm">By { frontmatter.author }</span>
			  </div>
			  <div class="flex items-center space-x-2">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
				  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
				</svg>
				<span class="text-sm">{ 5 } min read</span>
			  </div>
			</div>
			
			<!-- Content Slot -->
			<slot />
		</article>		  

        <!-- CTA Section -->
        <div class="mt-16 bg-green-50 p-8 rounded-lg shadow-lg">
          <h2 class="text-2xl font-semibold text-green-700 mb-2">Want to learn more about our menu or book a table?</h2>
          <p class="text-lg text-green-900 mb-8">
            Discover delicious vegan dishes, eco-friendly practices, and book your table today to enjoy a memorable dining experience.
          </p>
          <div class="text-center">
            <a href="/reservation" class="bg-green-600 text-white py-3 px-8 rounded-lg font-semibold shadow-md hover:bg-green-700 transition-all duration-300">Book a Table</a>
          </div>
        </div>
      </div>

      <!-- Sidebar (Aside) -->
      <aside class="w-full md:w-1/3 flex-shrink-0 bg-white p-6 rounded-lg space-y-8">
        <h2 class="text-2xl font-semibold text-green-700">Explore More</h2>

        <!-- Related Topics List -->
        <div class="space-y-4">
          <a href="#" class="block text-green-600 hover:text-green-800 text-lg font-medium">Plant-Based Nutrition Tips</a>
          <a href="#" class="block text-green-600 hover:text-green-800 text-lg font-medium">Vegan Recipes for Beginners</a>
          <a href="#" class="block text-green-600 hover:text-green-800 text-lg font-medium">Sustainable Dining Practices</a>
        </div>

        <!-- Restaurant Highlights -->
        <h3 class="text-xl font-semibold text-green-700">Restaurant Highlights</h3>
        <div class="space-y-4">
          <a href="#" class="block text-green-600 hover:text-green-800 text-lg font-medium">Vegan Gluten-Free Desserts</a>
          <a href="#" class="block text-green-600 hover:text-green-800 text-lg font-medium">Eco-Friendly Packaging</a>
          <a href="#" class="block text-green-600 hover:text-green-800 text-lg font-medium">Locally Sourced Ingredients</a>
        </div>
      </aside>
    </div>
  </section>
</Page>
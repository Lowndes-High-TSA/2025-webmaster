---
import Page from "../layouts/shared/Page.astro";
---

<Page title="Menu">
  <!-- Hero Section -->
  <section class="relative bg-green-700 text-white text-center py-20">
    <h1 class="text-5xl font-bold">Verdant Menu</h1>
    <p class="mt-4 text-lg">
      Fresh, organic, and flavorful plant-based dishes.
    </p>
  </section>

  <!-- Menu Categories -->
  <section class="max-w-6xl mx-auto p-8 bg-white shadow-lg rounded-lg mt-10">
    <h2 class="text-3xl font-semibold text-green-700 text-center">
      Our Offerings
    </h2>
    <div class="grid md:grid-cols-2 gap-6 mt-6">
      <!-- Salads -->
      <div class="bg-gray-50 shadow-md p-6 rounded-lg">
        <h3 class="text-xl font-bold">🥗 Salads</h3>
        <ul class="mt-2 text-gray-600">
          <li style="margin-bottom: 10px;">
            <strong>Avocado Salad</strong>&nbsp;&nbsp;&nbsp;<em>$10</em>
            <br>Avocados, mixed greens, cherry tomatoes, and citrus dressing.
          </li>
          <li style="margin-bottom: 10px;">
            <strong>Superfood Kale Salad</strong>&nbsp;&nbsp;&nbsp;<em>$10</em>
            <br>Kale, quinoa, blueberries, almonds, and lemon vinaigrette.
          </li>
          <li style="margin-bottom: 10px;">
            <strong>Mediterranean Chickpea Salad</strong>&nbsp;&nbsp;&nbsp;<em>$10</em>
            <br>Chickpeas, cucumbers, olives, vegan feta, and tahini dressing.
          </li>
        </ul>
      </div>
      <!-- Pastas -->
      <div class="bg-gray-50 shadow-md p-6 rounded-lg">
        <h3 class="text-xl font-bold">🍝 Pastas</h3>
        <ul class="mt-2 text-gray-600">
          <li style="margin-bottom: 10px;">
            <strong>Truffle Mushroom Pasta</strong>&nbsp;&nbsp;&nbsp;<em>$10</em>
            <br>Wild mushrooms, truffle oil, and creamy cashew sauce.
          </li>
          <li style="margin-bottom: 10px;">
            <strong>Sun-Dried Tomato Pesto Pasta</strong>&nbsp;&nbsp;&nbsp;<em>$10</em>
            <br>Sun-dried tomato pesto, roasted pine nuts, and fresh basil.
          </li>
          <li style="margin-bottom: 10px;">
            <strong>Spaghetti Primavera</strong>&nbsp;&nbsp;&nbsp;<em>$10</em>
            <br>Seasonal vegetables, garlic, and olive oil.
          </li>
        </ul>
      </div>
      <!-- Proteins -->
      <div class="bg-gray-50 shadow-md p-6 rounded-lg">
        <h3 class="text-xl font-bold">🌱 Protein</h3>
        <ul class="mt-2 text-gray-600">
          <li style="margin-bottom: 10px;">
            <strong>BBQ Jackfruit Sliders</strong>&nbsp;&nbsp;&nbsp;<em>$10</em>
            <br>Smoked jackfruit with house-made barbecue sauce.
          </li>
          <li style="margin-bottom: 10px;">
            <strong>Grilled Tofu Steak</strong>&nbsp;&nbsp;&nbsp;<em>$10</em>
            <br>Marinated tofu with herb-infused quinoa.
          </li>
          <li style="margin-bottom: 10px;">
            <strong>Chickpea Power Bowl</strong>&nbsp;&nbsp;&nbsp;<em>$10</em>
            <br>Roasted chickpeas, sweet potatoes, and tahini dressing.
          </li>
        </ul>
      </div>
      <!-- Sides -->
      <div class="bg-gray-50 shadow-md p-6 rounded-lg">
        <h3 class="text-xl font-bold">🍽️ Sides</h3>
        <ul class="mt-2 text-gray-600">
          <li style="margin-bottom: 10px;">
            <strong>Garlic Herb Fries</strong>&nbsp;&nbsp;&nbsp;<em>$10</em>
            <br>Crispy sweet potato fries with garlic and rosemary.
          </li>
          <li style="margin-bottom: 10px;">
            <strong>Spicy Roasted Cauliflower</strong>&nbsp;&nbsp;&nbsp;<em>$10</em>
            <br>Oven-roasted cauliflower with chili lime seasoning.
          </li>
          <li style="margin-bottom: 10px;">
            <strong>Avocado Toast</strong>&nbsp;&nbsp;&nbsp;<em>$10</em>
            <br>Sourdough toast topped with smashed avocado and microgreens.
          </li>
        </ul>
      </div>
    </div>

    <p style="margin-top: 25px; color: gray;" class="text-center"><b>Note:</b> <em>If anyone in your party has a food allergy, please tell your waiter prior to being served.</em></p>
  </section>

  <!-- Call-to-Action -->
  <section class="text-center mt-16">
    <h2 class="text-2xl font-bold">Start the Verdant experience.</h2>
    <a
      href="#"
      style="width: 400px; margin-bottom: 75px;"
      class="mt-4 inline-block bg-green-600 text-white px-6 py-3 rounded-full shadow-lg hover:bg-green-700"
      >Order Now</a
    >
  </section>
</Page>

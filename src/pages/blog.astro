---
import type { MarkdownInstance } from "astro";
import BlogCard from "../components/blog/BlogCard.astro";
import BlogGrid from "../layouts/blog/BlogGrid.astro";
import Page from "../layouts/shared/Page.astro";

const posts: MarkdownInstance<Record<string, any>>[] = Object.values(import.meta.glob('./posts/*.md', { eager: true }));
---

<Page title="Blog">
	<!-- Hero Section -->
	<section class="bg-gradient-to-r from-[#5C946E] to-[#84A98C] py-20">
	  <div class="container mx-auto text-center text-white">
		<h1 class="text-5xl font-extrabold leading-tight tracking-tight">Explore Our Latest Insights</h1>
		<p class="mt-4 text-lg font-light">Dive into our blog for fresh perspectives, tips, and stories.</p>
	  </div>
	</section>

	<!-- Blog Section -->
	<div class="container bg-gray-50 px-4 py-20 mx-auto">
		  <BlogGrid>
			{
				posts.map(
					(post) => {
						return <BlogCard
							href={ post.url }
							image={ post.frontmatter.image.url }
							title={ post.frontmatter.title }
							description={ post.frontmatter.description }
							author={ post.frontmatter.author }
							published={ new Date(post.frontmatter.published)
								.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) }
						/>;
					}
				)
			}
		</BlogGrid>
	</div>
</Page>